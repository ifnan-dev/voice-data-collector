# Backend environment variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000

# Supabase (service-role key - keep secret, backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage bucket name for audio files (private bucket)
SUPABASE_STORAGE_BUCKET=speech-recordings

# Transcription (manual only - no auto-transcription)
TRANSCRIPTION_ENGINE=stub
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
