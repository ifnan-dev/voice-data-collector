# Backend environment variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000

# Supabase (backend only - keep secret)
# Use either:
#   - the legacy service_role key (JWT), or
#   - a new sb_secret_... secret key (elevated privileges, bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-or-sb-secret-key

# Supabase Storage bucket name for audio files (private bucket)
SUPABASE_STORAGE_BUCKET=speech-recordings

# Transcription (manual only - no auto-transcription)
TRANSCRIPTION_ENGINE=stub
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
