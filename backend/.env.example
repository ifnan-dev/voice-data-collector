# Backend environment variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000

# Supabase Postgres (backend only - keep secret)
# Holds the speech_records metadata table. Accepts either the legacy
# service_role JWT key or a new sb_secret_... secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-or-sb-secret-key

# Cloudflare R2 object storage (backend only - keep secret)
# Audio files are stored in R2 (S3-compatible). Create an R2 token with
# Object Read & Write and paste the credentials below.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=speech-recordings
# Optional: public base URL for a public bucket (e.g. https://pub-xxx.r2.dev).
# Leave empty to use short-lived presigned URLs for a private bucket.
R2_PUBLIC_BASE_URL=

# Transcription (manual only - no auto-transcription)
TRANSCRIPTION_ENGINE=stub
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8