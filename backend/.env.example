# Backend environment variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000

# Supabase (service-role key - keep secret, backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (S3-compatible) - keep secret, backend only
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=speech-recordings
R2_REGION=auto
R2_PUBLIC_URL=https://your-account-id.r2.cloudflarestorage.com/speech-recordings

# Transcription
TRANSCRIPTION_ENGINE=stub  # whisper | stub | custom-asr (stub runs offline without downloading a model)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8
