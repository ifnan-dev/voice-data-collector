[Unit]
Description=Afaan Oromo Speech Data Collection API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/afan-oromo/backend
EnvironmentFile=/opt/afan-oromo/backend/.env
ExecStart=/opt/afan-oromo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target